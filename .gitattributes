* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.properties text eol=lf
# Generated by the build (Directory.Build.targets writes LF); keep the checkout byte-identical on Windows too.
**/openapi/*.json text eol=lf
# Scripts that run inside Linux containers (bind-mounted by the AppHost, copied into images, mounted by the charts): psql and mongosh
# must see LF on Windows checkouts too.
*.sql text eol=lf
infra/mongo/*.js text eol=lf
deploy/charts/*/files/** text eol=lf
