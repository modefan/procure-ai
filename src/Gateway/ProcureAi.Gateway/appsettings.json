{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": { "service.name": "gateway" }
        }
      }
    }
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/procure",
    "ClientId": "procure-gateway",
    "ClientSecret": "",
    "Scopes": [ "openid" ],
    "RequireHttpsMetadata": true
  },
  "Session": {
    "RefreshSkewSeconds": 60,
    "IdleTimeoutMinutes": 480,
    "RedisKeyPrefix": "procure:bff:"
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Swagger": {
    "OAuthClientId": "procure-swagger",
    "Definitions": [
      { "Name": "requests", "Url": "/openapi/requests/v1.json" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "requests-api": {
        "ClusterId": "requests",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/requests/{**catch-all}" }
      },
      "requests-openapi": {
        "ClusterId": "requests",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/requests/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "web": {
        "ClusterId": "web",
        "Order": 1000,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "requests": { "Destinations": { "d1": { "Address": "http://localhost:5100" } } },
      "web": { "Destinations": { "d1": { "Address": "http://localhost:4200" } } }
    }
  },
  "AllowedHosts": "*"
}
