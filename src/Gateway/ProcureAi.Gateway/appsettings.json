{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": { "service.name": "gateway" }
        }
      }
    }
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/procure",
    "ClientId": "procure-gateway",
    "ClientSecret": "",
    "Scopes": [ "openid" ],
    "RequireHttpsMetadata": true
  },
  "Session": {
    "RefreshSkewSeconds": 60,
    "IdleTimeoutMinutes": 480,
    "RedisKeyPrefix": "procure:bff:"
  },
  "Registration": {
    "DemoTenantId": "demo"
  },
  "AccessClient": {
    "CacheDuration": "00:00:30",
    "FailSafeMaxDuration": "01:00:00",
    "FailSafeThrottleDuration": "00:00:05",
    "RetryCount": 1,
    "RetryDelay": "00:00:00.200",
    "AttemptTimeout": "00:00:03",
    "TotalTimeout": "00:00:08"
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Swagger": {
    "OAuthClientId": "procure-swagger",
    "Definitions": [
      { "Name": "requests", "Url": "/openapi/requests/v1.json" },
      { "Name": "access", "Url": "/openapi/access/v1.json" },
      { "Name": "budgets", "Url": "/openapi/budgets/v1.json" },
      { "Name": "approvals", "Url": "/openapi/approvals/v1.json" },
      { "Name": "audit", "Url": "/openapi/audit/v1.json" },
      { "Name": "suppliers", "Url": "/openapi/suppliers/v1.json" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "requests-api": {
        "ClusterId": "requests",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/requests/{**catch-all}" }
      },
      "requests-openapi": {
        "ClusterId": "requests",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/requests/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "access-api": {
        "ClusterId": "access",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/access/{**catch-all}" }
      },
      "access-openapi": {
        "ClusterId": "access",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/access/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "budgets-api": {
        "ClusterId": "budgets",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/budgets/{**catch-all}" }
      },
      "budgets-openapi": {
        "ClusterId": "budgets",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/budgets/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "approvals-api": {
        "ClusterId": "approvals",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/approvals/{**catch-all}" }
      },
      "approvals-openapi": {
        "ClusterId": "approvals",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/approvals/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "audit-api": {
        "ClusterId": "audit",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/audit/{**catch-all}" }
      },
      "audit-openapi": {
        "ClusterId": "audit",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/audit/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "suppliers-api": {
        "ClusterId": "suppliers",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/suppliers/{**catch-all}" }
      },
      "suppliers-openapi": {
        "ClusterId": "suppliers",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/suppliers/v1.json" },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "web": {
        "ClusterId": "web",
        "Order": 1000,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "requests": { "Destinations": { "d1": { "Address": "http://localhost:5100" } } },
      "access": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "budgets": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "approvals": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } },
      "audit": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } },
      "suppliers": { "Destinations": { "d1": { "Address": "http://localhost:5105" } } },
      "web": { "Destinations": { "d1": { "Address": "http://localhost:4200" } } }
    }
  },
  "AllowedHosts": "*"
}
