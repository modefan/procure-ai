<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Someone else's systems (a supplier and an ERP). Deliberately depends on ServiceDefaults only: no BuildingBlocks, no Contracts
       (an architecture test enforces it), so the services must talk to it through its HTTP and webhook contract like to a real vendor. -->
  <PropertyGroup>
    <RootNamespace>ProcureAi.Simulators</RootNamespace>
    <!-- EXTEXP0001: RemoveAllResilienceHandlers (the webhook sender does its own retries) is an experimental API of Microsoft.Extensions.Http.Resilience. -->
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ServiceDefaults/ProcureAi.ServiceDefaults/ProcureAi.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Simulators.Tests" />
  </ItemGroup>

</Project>
