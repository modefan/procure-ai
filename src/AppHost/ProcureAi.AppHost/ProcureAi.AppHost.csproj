<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>procure-ai-apphost</UserSecretsId>
    <!-- ASPIRE010: AspireUseCliBundle defaults to false (orchestration comes from NuGet packages). Enabling it needs the separately installed Aspire CLI bundle, which we do not use. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Services/Requests/ProcureAi.Requests.Api/ProcureAi.Requests.Api.csproj" />
    <ProjectReference Include="../../Services/Access/ProcureAi.Access.Api/ProcureAi.Access.Api.csproj" />
    <ProjectReference Include="../../Services/Budgets/ProcureAi.Budgets.Api/ProcureAi.Budgets.Api.csproj" />
    <ProjectReference Include="../../Services/Approvals/ProcureAi.Approvals.Api/ProcureAi.Approvals.Api.csproj" />
    <ProjectReference Include="../../Gateway/ProcureAi.Gateway/ProcureAi.Gateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.MongoDB" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

</Project>
