{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Persistence": {
    "UseDataVolumes": true
  },
  "Debezium": {
    "SelfHealLostOffsets": true,
    "HeartbeatIntervalMs": 60000
  },
  "Postgres": {
    "MaxSlotWalKeepSize": "1GB"
  },
  "Simulators": {
    "Supplier": { "ConfirmDelay": "00:00:03", "InvoiceDelay": "00:00:20" }
  },
  "Parameters": {
    "keycloak-admin": "keycloak-admin"
  },
  "Resources": {
    "Postgres": { "MemoryMb": 768, "Cpus": 1, "SharedBuffers": "128MB", "WorkMem": "4MB", "MaxConnections": 200, "PoolSizePerService": 8, "ReservedConnections": 30 },
    "Mongo": { "MemoryMb": 512, "Cpus": 1, "WiredTigerCacheGb": 0.25 },
    "Keycloak": { "MemoryMb": 768, "Cpus": 1, "JavaHeapOpts": "-Xms256m -Xmx512m" },
    "Debezium": { "MemoryMb": 512, "Cpus": 0.3, "JavaOpts": "-Xmx256m" },
    "RabbitMq": { "MemoryMb": 384, "Cpus": 1, "VmMemoryHighWatermarkAbsolute": "256MiB" },
    "Redis": { "MemoryMb": 192, "Cpus": 1, "MaxMemory": "128mb", "MaxMemoryPolicy": "volatile-ttl" },
    "Mailpit": { "MemoryMb": 64, "Cpus": 0.5 },
    "DotNet": { "GcServer": 0, "GcConserveMemory": 5, "GcHeapHardLimit": "0x10000000" },
    "Angular": { "NodeOptions": "--max-old-space-size=1024" }
  }
}
