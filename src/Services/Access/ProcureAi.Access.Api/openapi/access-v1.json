    "/api/v1/access/internal/users/{userId}/tenants": {
      "get": {
        "tags": [
          "UserTenants"
        ],
        "operationId": "ListUserTenants",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenantDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproverDto": {
        "required": [
          "userId",
          "displayName",
          "approvalLimit",
          "canApprove"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "approvalLimit": {
            "type": "number",
            "format": "double"
          },
          "canApprove": {
            "type": "boolean"
          }
        }
      },
      "CostCenterApproversDto": {
        "required": [
          "costCenterCode",
          "departmentCode",
          "manager",
          "departmentHead",
          "finance"
        ],
        "type": "object",
        "properties": {
          "costCenterCode": {
            "type": "string"
          },
          "departmentCode": {
            "type": "string"
          },
          "manager": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApproverDto"
              }
            ]
          },
          "departmentHead": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ApproverDto"
              }
            ]
          },
          "finance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApproverDto"
            }
          }
        }
      },
      "CostCenterDto": {
        "required": [
          "code",
          "name",
          "departmentCode"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "departmentCode": {
            "type": "string"
          }
        }
      },
      "EffectiveAccessDto": {
        "required": [
          "permissions",
          "costCenterCodes",
          "approvalLimit"
        ],
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "costCenterCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvalLimit": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MatrixDto": {
        "required": [
          "tenantId",
          "version",
          "availablePermissions",
          "roles"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          },
          "availablePermissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleDto"
            }
          }
        }
      },
      "MeDto": {
        "required": [
          "userId",
          "name",
          "roles",
          "costCenters",
          "approvalLimit"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "costCenters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostCenterDto"
            }
          },
          "approvalLimit": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "tenantName": {
            "type": "string",
            "default": ""
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterDemoUserBody": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      },
      "RegistrationDto": {
        "required": [
          "tenantId",
          "joined"
        ],
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "joined": {
            "type": "boolean"
          }
        }
      },
      "RoleDto": {
        "required": [
          "role",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SetApprovalLimitBody": {
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SetRolePermissionsBody": {
        "required": [
          "permissions"
        ],
        "type": "object",
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TenantDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UserDto": {
        "required": [
          "userId",
          "displayName",
          "email",
          "roles",
          "approvalLimit",
          "isFinanceApprover",
          "costCenterCodes",
          "version"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approvalLimit": {
            "type": "number",
            "format": "double"
          },
          "isFinanceApprover": {
            "type": "boolean"
          },
          "costCenterCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "UserNameDto": {
        "required": [
          "userId",
          "displayName",
          "email"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "tenantName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's testing access). Send X-Tenant-Id with it on tenant endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "profile"
      ]
    }
  ],
  "tags": [
    {
      "name": "Access"
    },
    {
      "name": "UserTenants"
    }
  ]
}