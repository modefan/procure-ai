<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Access.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-access-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Access.Application/ProcureAi.Access.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Access.Infrastructure/ProcureAi.Access.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>access-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>accessdb</OpenApiDatabaseConnectionName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Access.IntegrationTests" />
  </ItemGroup>

</Project>
