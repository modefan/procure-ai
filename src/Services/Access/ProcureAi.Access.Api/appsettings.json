{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "ZiggyCreatures": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": { "service.name": "access-api" }
        }
      }
    }
  },
  "Service": {
    "DatabaseConnectionName": "accessdb"
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/procure",
    "Audience": "procure-api",
    "RequireHttpsMetadata": true,
    "AdminApiKeySha256": "",
    "OpenApi": {
      "AuthorizationUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/auth",
      "TokenUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/token",
      "Scopes": { "openid": "OpenID Connect", "profile": "Profile", "organization": "Company (tenant) of the user" }
    }
  },
  "Keycloak": {
    "AdminBaseUrl": "http://localhost:8080",
    "Realm": "procure",
    "DemoOrganization": "demo",
    "AdminClientId": "procure-access-admin",
    "AdminClientSecret": "",
    "OrganizationLookupTimeout": "00:00:03"
  },
  "DemoRegistration": {
    "SandboxCostCenter": "DEMO-100"
  },
  "Caching": {
    "DefaultGetSeconds": 1,
    "LockTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "WaitTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05",
    "MaxKeyLength": 255
  },
  "FusionCache": {
    "DefaultDuration": "00:00:01",
    "DistributedTtlPadding": "00:00:01"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "Headers": "XForwardedProto"
  },
  "Wolverine": {
    "AutoBuildMessageStorageOnStartup": "None"
  },
  "Status": {
    "PublishInterval": "00:00:10",
    "Ttl": "00:00:30",
    "PartTimeout": "00:00:02"
  },
  "AllowedHosts": "*"
}
