{
  "openapi": "3.1.1",
  "info": {
    "title": "ProcureAi Requests API",
    "description": "HTTP API of the requests-api service of the ProcureAi demo.",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/requests": {
      "post": {
        "tags": [
          "Requests"
        ],
        "operationId": "CreateRequest",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestBody"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestBody"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDto"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Requests"
        ],
        "operationId": "ListRequests",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/RequestStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfRequestDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests/{id}": {
      "get": {
        "tags": [
          "Requests"
        ],
        "operationId": "GetRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Requests"
        ],
        "operationId": "UpdateRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "The ETag of the version you last read, e.g. \"3\". Missing: 428; stale: 412.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRequestBody"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRequestBody"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDto"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/requests/{id}/submit": {
      "post": {
        "tags": [
          "Requests"
        ],
        "operationId": "SubmitRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "The ETag of the version you last read, e.g. \"3\". Missing: 428; stale: 412.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDto"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "428": {
            "description": "Precondition Required",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRequestBody": {
        "required": [
          "title",
          "costCenterCode",
          "supplierId",
          "lines"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "costCenterCode": {
            "type": "string"
          },
          "supplierId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineBody"
            }
          }
        }
      },
      "LineBody": {
        "required": [
          "sku",
          "description",
          "quantity",
          "unitPriceExclVat"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPriceExclVat": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "PagedResultOfRequestDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RequestDto": {
        "required": [
          "id",
          "number",
          "title",
          "status",
          "costCenterCode",
          "supplierId",
          "lines",
          "totalExclVat",
          "vat",
          "totalInclVat",
          "totalExclVatDisplay",
          "vatDisplay",
          "totalInclVatDisplay",
          "submittedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "costCenterCode": {
            "type": "string"
          },
          "supplierId": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestLineDto"
            }
          },
          "totalExclVat": {
            "type": "number",
            "format": "double"
          },
          "vat": {
            "type": "number",
            "format": "double"
          },
          "totalInclVat": {
            "type": "number",
            "format": "double"
          },
          "totalExclVatDisplay": {
            "type": "string"
          },
          "vatDisplay": {
            "type": "string"
          },
          "totalInclVatDisplay": {
            "type": "string"
          },
          "submittedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "RequestLineDto": {
        "required": [
          "lineNo",
          "sku",
          "description",
          "quantity",
          "unitPriceExclVat",
          "totalExclVat",
          "unitPriceExclVatDisplay",
          "totalExclVatDisplay"
        ],
        "type": "object",
        "properties": {
          "lineNo": {
            "type": "integer",
            "format": "int32"
          },
          "sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPriceExclVat": {
            "type": "number",
            "format": "double"
          },
          "totalExclVat": {
            "type": "number",
            "format": "double"
          },
          "unitPriceExclVatDisplay": {
            "type": "string"
          },
          "totalExclVatDisplay": {
            "type": "string"
          }
        }
      },
      "RequestStatus": {
        "enum": [
          "Draft",
          "Submitted"
        ]
      },
      "UpdateRequestBody": {
        "required": [
          "title",
          "lines"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineBody"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's testing access). Send X-Tenant-Id with it on tenant endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "profile"
      ]
    }
  ],
  "tags": [
    {
      "name": "Requests"
    }
  ]
}