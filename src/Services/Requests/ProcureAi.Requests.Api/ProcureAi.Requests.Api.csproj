<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Requests.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-requests-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Requests.Application/ProcureAi.Requests.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Requests.Infrastructure/ProcureAi.Requests.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>requests-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>requestsdb</OpenApiDatabaseConnectionName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Requests.IntegrationTests" />
  </ItemGroup>

</Project>
