<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Purchasing.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-purchasing-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Purchasing.Application/ProcureAi.Purchasing.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Purchasing.Infrastructure/ProcureAi.Purchasing.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>purchasing-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>purchasingdb</OpenApiDatabaseConnectionName>
    <!-- Settings validated at startup that are secrets or addresses in a deployment (placeholders: nothing connects to them). -->
    <OpenApiExtraSettings>SupplierClient__BaseUrl=http://openapi.invalid/;SupplierClient__ApiKey=openapi-placeholder;Webhooks__Sources__supplier__Secret=openapi-placeholder-secret-0000000000000000</OpenApiExtraSettings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Purchasing.IntegrationTests" />
  </ItemGroup>

</Project>
