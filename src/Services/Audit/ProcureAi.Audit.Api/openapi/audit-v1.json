{
  "openapi": "3.1.1",
  "info": {
    "title": "ProcureAi Audit API",
    "description": "HTTP API of the audit-api service of the ProcureAi demo.",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/audit/requests/{requestId}/history": {
      "get": {
        "tags": [
          "Audit"
        ],
        "operationId": "GetRequestHistory",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BusinessEventDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BusinessEventDto": {
        "required": [
          "type",
          "userId",
          "occurredAt",
          "summary"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's testing access). Send X-Tenant-Id with it on tenant endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "profile"
      ]
    }
  ],
  "tags": [
    {
      "name": "Audit"
    }
  ]
}