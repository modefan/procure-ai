{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "ZiggyCreatures": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": { "service.name": "audit-api" }
        }
      }
    }
  },
  "Service": {
    "DatabaseConnectionName": "auditdb"
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/procure",
    "Audience": "procure-api",
    "RequireHttpsMetadata": true,
    "AdminApiKeySha256": "",
    "OpenApi": {
      "AuthorizationUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/auth",
      "TokenUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/token",
      "Scopes": { "openid": "OpenID Connect", "profile": "Profile" }
    }
  },
  "Caching": {
    "DefaultGetSeconds": 1,
    "LockTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "WaitTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05",
    "MaxKeyLength": 255
  },
  "FusionCache": {
    "DefaultDuration": "00:00:01",
    "DistributedTtlPadding": "00:00:01"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "AccessClient": {
    "CacheDuration": "00:05:00",
    "FailSafeMaxDuration": "01:00:00",
    "FailSafeThrottleDuration": "00:00:05",
    "RetryCount": 1,
    "RetryDelay": "00:00:00.200",
    "AttemptTimeout": "00:00:03",
    "TotalTimeout": "00:00:08"
  },
  "Paging": {
    "MaxPageSize": 100,
    "DefaultPageSize": 25
  },
  "Audit": {
    "DisplayNameTimeout": "00:00:02",
    "Matching": {
      "Window": "00:10:00",
      "Grace": "00:00:30"
    },
    "RetentionDays": 90,
    "PurgeInterval": "1.00:00:00",
    "PurgeBatchSize": 500,
    "Cdc": {
      "DefaultKeyColumns": [ "id" ],
      "KeyColumns": {
        "request_lines": [ "request_id", "line_no" ],
        "tenant_sequences": [ "tenant_id", "name" ],
        "budget_reservations": [ "budget_id", "request_id" ],
        "budget_spends": [ "budget_id", "payment_id" ],
        "request_markers": [ "tenant_id", "request_id" ],
        "cost_centers": [ "tenant_id", "code" ],
        "departments": [ "tenant_id", "code" ],
        "permission_matrices": [ "tenant_id" ],
        "tenant_users": [ "tenant_id", "user_id" ],
        "permission_grants": [ "tenant_id", "role", "permission" ],
        "order_lines": [ "order_id", "line_no" ],
        "receipt_lines": [ "receipt_id", "line_no" ],
        "processed_webhooks": [ "source", "event_id" ],
        "order_view_lines": [ "order_id", "line_no" ],
        "invoice_lines": [ "invoice_id", "line_no" ],
        "payment_lines": [ "payment_id", "line_no" ],
        "policy_document_files": [ "document_id", "version" ],
        "purchases": [ "request_id" ]
      },
      "RequestTables": [ "purchase_requests" ],
      "MaskedCollections": [ "assistantchatdb.conversations" ],
      "MongoStampWindow": "00:00:30"
    },
    "ConcurrencyRetry": {
      "Attempts": 10,
      "InitialDelay": "00:00:00.050",
      "Multiplier": 2.0,
      "MaxDelay": "00:00:02",
      "JitterFraction": 0.5
    },
    "Marten": {
      "AutoCreateSchemaObjects": "None"
    }
  },
  "PgAudit": {
    "ConnectionName": "auditlog",
    "Schema": "pgaudit",
    "LogFileTemplate": "log/postgresql-{0}.csv",
    "Window": "1.00:00:00",
    "LatestCount": 10,
    "TextMaxLength": 200,
    "IgnoredDdlSchemas": [ "wolverine" ]
  },
  "Wolverine": {
    "AutoBuildMessageStorageOnStartup": "None"
  },
  "Status": {
    "PublishInterval": "00:00:10",
    "Ttl": "00:00:30",
    "PartTimeout": "00:00:02"
  },
  "AllowedHosts": "*"
}
