{
  "openapi": "3.1.1",
  "info": {
    "title": "ProcureAi Notifications API",
    "description": "HTTP API of the notifications-api service of the ProcureAi demo.",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "operationId": "ListNotifications",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BellList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{id}/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "MarkNotificationRead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "MarkAllNotificationsRead",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BellItem": {
        "required": [
          "id",
          "text",
          "requestId",
          "link",
          "createdAt",
          "read"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "requestId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "link": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "read": {
            "type": "boolean"
          }
        }
      },
      "BellList": {
        "required": [
          "items",
          "unread"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BellItem"
            }
          },
          "unread": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's testing access). Send X-Tenant-Id with it on tenant endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "profile"
      ]
    }
  ],
  "tags": [
    {
      "name": "Notifications"
    }
  ]
}