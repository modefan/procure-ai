{
  "openapi": "3.1.1",
  "info": {
    "title": "ProcureAi Notifications API",
    "description": "HTTP API of the notifications-api service of the ProcureAi demo.",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/notifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "operationId": "ListNotifications",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BellList"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": [ ],
            "TenantId": [ ]
          },
          {
            "OAuth2": [
              "email",
              "openid",
              "organization",
              "profile"
            ]
          }
        ]
      }
    },
    "/api/v1/notifications/{id}/read": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "MarkNotificationRead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": [ ],
            "TenantId": [ ]
          },
          {
            "OAuth2": [
              "email",
              "openid",
              "organization",
              "profile"
            ]
          }
        ]
      }
    },
    "/api/v1/notifications/read-all": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "operationId": "MarkAllNotificationsRead",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique value per submission (e.g. a GUID). Repeating it replays the first result.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "ApiKey": [ ],
            "TenantId": [ ]
          },
          {
            "OAuth2": [
              "email",
              "openid",
              "organization",
              "profile"
            ]
          }
        ]
      }
    },
    "/api/v1/notifications/system-status": {
      "get": {
        "tags": [
          "SystemStatus"
        ],
        "operationId": "GetSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusDto"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": [ ],
            "TenantId": [ ]
          },
          {
            "OAuth2": [
              "email",
              "openid",
              "organization",
              "profile"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BellItem": {
        "required": [
          "id",
          "text",
          "requestId",
          "link",
          "createdAt",
          "read"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "requestId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "link": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "read": {
            "type": "boolean"
          }
        }
      },
      "BellList": {
        "required": [
          "items",
          "unread"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BellItem"
            }
          },
          "unread": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BreakerDto": {
        "required": [
          "name",
          "state",
          "retryAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CircuitState"
          },
          "retryAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ChaosDto": {
        "required": [
          "mode",
          "restoresAt"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ChaosMode"
          },
          "restoresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ChaosMode": {
        "enum": [
          "Normal",
          "Slow",
          "Failing",
          "Down"
        ]
      },
      "CircuitState": {
        "enum": [
          "Closed",
          "HalfOpen",
          "Open"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ServiceHealth": {
        "enum": [
          "Healthy",
          "Degraded",
          "Unhealthy",
          "Down"
        ]
      },
      "ServiceStatusDto": {
        "required": [
          "name",
          "health",
          "instances",
          "breakers",
          "messages"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/ServiceHealth"
          },
          "instances": {
            "type": "integer",
            "format": "int32"
          },
          "breakers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BreakerDto"
            }
          },
          "messages": {
            "$ref": "#/components/schemas/WolverineCountsDto"
          }
        }
      },
      "StatusItem": {
        "required": [
          "kind",
          "text",
          "tenantId",
          "at",
          "link"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "link": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemStatusDto": {
        "required": [
          "at",
          "services",
          "counters",
          "alerts",
          "supplierChaos"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceStatusDto"
            }
          },
          "counters": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            }
          },
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusItem"
            }
          },
          "supplierChaos": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChaosDto"
              }
            ]
          }
        }
      },
      "WolverineCountsDto": {
        "required": [
          "incoming",
          "outgoing",
          "scheduled",
          "deadLetters",
          "brokerDeadLetters"
        ],
        "type": "object",
        "properties": {
          "incoming": {
            "type": "integer",
            "format": "int64"
          },
          "outgoing": {
            "type": "integer",
            "format": "int64"
          },
          "scheduled": {
            "type": "integer",
            "format": "int64"
          },
          "deadLetters": {
            "type": "integer",
            "format": "int64"
          },
          "brokerDeadLetters": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's and the operator's access; all permissions in every organisation). Tenant endpoints also need TenantId below.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "TenantId": {
        "type": "apiKey",
        "description": "Only with the admin API key: the organisation a tenant endpoint acts in, e.g. acme or globex. Sent as X-Tenant-Id on the endpoints that need one (their lock lists TenantId). Without it they answer 400. A Keycloak login (OAuth2) takes the organisation from the token and ignores this header.",
        "name": "X-Tenant-Id",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "organization": "Company (tenant) of the user",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "organization",
        "profile"
      ]
    }
  ],
  "tags": [
    {
      "name": "Notifications"
    },
    {
      "name": "SystemStatus"
    }
  ]
}