{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.AspNetCore.Http.Connections": "Warning",
        "System.Net.Http": "Warning",
        "ZiggyCreatures": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": { "service.name": "notifications-api" }
        }
      }
    }
  },
  "Service": {
    "Store": "None"
  },
  "Notifications": {
    "SignalR": { "ChannelPrefix": "procure-signalr" },
    "PushRetry": { "Attempts": 3, "InitialDelay": "00:00:00.200", "Multiplier": 5, "MaxDelay": "00:00:05" },
    "Presence": {
      "HeartbeatInterval": "00:00:15",
      "Ttl": "00:00:45",
      "SweepInterval": "00:00:15",
      "SweepLockWait": "00:00:05",
      "MaxWatchesPerConnection": 20
    },
    "Bell": { "MaxItems": 50, "Retention": "30.00:00:00" },
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "From": "no-reply@procure-ai.local",
      "FromName": "Procure AI",
      "AppBaseUrl": "https://localhost:7443",
      "DedupWindow": "7.00:00:00",
      "SendingClaimTtl": "00:02:00"
    }
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/procure",
    "Audience": "procure-api",
    "RequireHttpsMetadata": true,
    "AdminApiKeySha256": "",
    "OpenApi": {
      "AuthorizationUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/auth",
      "TokenUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/token",
      "Scopes": { "openid": "OpenID Connect", "profile": "Profile", "organization": "Company (tenant) of the user" }
    }
  },
  "Caching": {
    "DefaultGetSeconds": 1,
    "LockTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "WaitTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05",
    "MaxKeyLength": 255
  },
  "FusionCache": {
    "DefaultDuration": "00:00:01",
    "DistributedTtlPadding": "00:00:01"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "Headers": "XForwardedProto"
  },
  "AccessClient": {
    "CacheDuration": "00:05:00",
    "FailSafeMaxDuration": "01:00:00",
    "FailSafeThrottleDuration": "00:00:05",
    "RetryCount": 1,
    "RetryDelay": "00:00:00.200",
    "AttemptTimeout": "00:00:03",
    "TotalTimeout": "00:00:08"
  },
  "Paging": {
    "MaxPageSize": 100,
    "DefaultPageSize": 25
  },
  "Status": {
    "PublishInterval": "00:00:10",
    "Ttl": "00:00:30",
    "PartTimeout": "00:00:02"
  },
  "AllowedHosts": "*"
}
