<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Assistant.Api</RootNamespace>
    <!-- The AI key (AI__ApiKey) and other local-only settings come from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-assistant-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Assistant.Application/ProcureAi.Assistant.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Assistant.Infrastructure/ProcureAi.Assistant.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). Postgres is the main store; the
       chat database on MongoDB needs a mongodb:// placeholder of its own (its URL is parsed at startup). -->
  <PropertyGroup>
    <OpenApiDocumentName>assistant-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>assistantdb</OpenApiDatabaseConnectionName>
    <OpenApiExtraSettings>ConnectionStrings__assistantchatdb=mongodb://openapi.invalid/assistantchatdb</OpenApiExtraSettings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Assistant.IntegrationTests" />
  </ItemGroup>

</Project>
