{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning",
        "ZiggyCreatures": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console"
      },
      "OpenTelemetry": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "assistant-api"
          }
        }
      }
    }
  },
  "Service": {
    "DatabaseConnectionName": "assistantdb",
    "SecondaryMongoConnectionName": "assistantchatdb"
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/procure",
    "Audience": "procure-api",
    "RequireHttpsMetadata": true,
    "AdminApiKeySha256": "",
    "OpenApi": {
      "AuthorizationUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/auth",
      "TokenUrl": "http://localhost:8080/realms/procure/protocol/openid-connect/token",
      "Scopes": {
        "openid": "OpenID Connect",
        "profile": "Profile",
        "organization": "Company (tenant) of the user"
      }
    }
  },
  "Caching": {
    "DefaultGetSeconds": 1,
    "LockTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00",
    "WaitTimeout": "00:00:10",
    "RetryAfterSeconds": 1,
    "FailureShare": "00:00:05",
    "MaxKeyLength": 255
  },
  "FusionCache": {
    "DefaultDuration": "00:00:01",
    "DistributedTtlPadding": "00:00:01"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 1,
    "QueueLimit": 0
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "AccessClient": {
    "CacheDuration": "00:05:00",
    "FailSafeMaxDuration": "01:00:00",
    "FailSafeThrottleDuration": "00:00:05",
    "RetryCount": 1,
    "RetryDelay": "00:00:00.200",
    "AttemptTimeout": "00:00:03",
    "TotalTimeout": "00:00:08"
  },
  "AI": {
    "Provider": "Fake",
    "Endpoint": "",
    "ApiKey": "",
    "DailyTokenCapPerTenant": 200000,
    "Chat": {
      "Model": "chat",
      "MaxOutputTokens": 800,
      "Timeout": "00:01:00",
      "SupportsTemperature": true
    },
    "Embedding": {
      "Model": "embeddings",
      "Dimensions": 1536
    },
    "Guard": {
      "Model": ""
    },
    "Telemetry": {
      "LogContent": false
    },
    "Prices": {
      "InputPerMillionUsd": 0.25,
      "OutputPerMillionUsd": 2.0,
      "EmbeddingPerMillionUsd": 0.022
    },
    "Fake": {
      "StreamDelayMs": 15
    },
    "Resilience": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 4,
      "SamplingDuration": "00:01:00",
      "BreakDuration": "00:00:30",
      "ProviderMaxRetries": 1
    }
  },
  "Assistant": {
    "Tools": {
      "MaxCallsPerQuestion": 5,
      "Timeout": "00:00:10",
      "MaxResultLength": 1500,
      "TimeZone": "Africa/Johannesburg"
    },
    "ToolClients": {
      "RetryCount": 1,
      "RetryDelay": "00:00:00.200",
      "AttemptTimeout": "00:00:03",
      "TotalTimeout": "00:00:08"
    },
    "Quota": {
      "QuestionsPerDay": 50,
      "TimeZone": "Africa/Johannesburg"
    },
    "Answer": {
      "LockLease": "00:00:30",
      "HistoryMessages": 6
    },
    "Guard": {
      "Classifier": "Model",
      "MaxQuestionLength": 2000,
      "OutputWindow": 200,
      "HoldBackChars": 64
    },
    "Chunking": {
      "MinTokens": 300,
      "MaxTokens": 800,
      "MaxParentTokens": 2000,
      "OverlapPercent": 12
    },
    "Ingestion": {
      "BatchSize": 32,
      "ContextualRetrieval": true,
      "RetryDelays": "00:00:10, 00:01:00, 00:05:00",
      "MaxParallelDocuments": 2
    },
    "Uploads": {
      "MaxBytes": 10485760
    },
    "Retrieval": {
      "TopK": 6,
      "CandidatesPerArm": 20,
      "RrfK": 60,
      "Rerank": false
    },
    "Purchases": {
      "RetryDelays": "00:00:05, 00:00:30, 00:02:00",
      "TimeZone": "Africa/Johannesburg",
      "PlaceholderMaxAge": "7.00:00:00",
      "PlaceholderCleanupInterval": "01:00:00",
      "ConcurrencyRetry": {
        "Attempts": 10,
        "InitialDelay": "00:00:00.050",
        "Multiplier": 2.0,
        "MaxDelay": "00:00:02",
        "JitterFraction": 0.5
      },
      "DependencyRetry": {
        "Attempts": 5,
        "InitialDelay": "00:00:05",
        "Multiplier": 3.0,
        "MaxDelay": "00:05:00"
      }
    }
  },
  "Paging": {
    "MaxPageSize": 100,
    "DefaultPageSize": 25
  },
  "Wolverine": {
    "AutoBuildMessageStorageOnStartup": "None"
  },
  "Status": {
    "PublishInterval": "00:00:10",
    "Ttl": "00:00:30",
    "PartTimeout": "00:00:02"
  },
  "AllowedHosts": "*"
}
