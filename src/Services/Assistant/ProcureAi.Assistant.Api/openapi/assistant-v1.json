  "components": {
    "schemas": {
      "AssistantInfo": {
        "required": [
          "provider",
          "chatModel",
          "demoModel",
          "questionsPerDay"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "chatModel": {
            "type": "string"
          },
          "demoModel": {
            "type": "boolean"
          },
          "questionsPerDay": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "PagedResultOfPolicyDocumentDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PolicyDocumentDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PolicyDocumentDto": {
        "required": [
          "id",
          "title",
          "fileName",
          "version",
          "currentVersion",
          "status",
          "progress",
          "chunkCount",
          "uploadedAt",
          "uploadedByName",
          "flaggedReason",
          "failureReason",
          "rowVersion"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "currentVersion": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "progress": {
            "type": "integer",
            "format": "int32"
          },
          "chunkCount": {
            "type": "integer",
            "format": "int32"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "uploadedByName": {
            "type": "string"
          },
          "flaggedReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "rowVersion": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "The admin API key (Claude's testing access). Send X-Tenant-Id with it on tenant endpoints.",
        "name": "X-Api-Key",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "Keycloak login: authorization code flow with PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://openapi.invalid/auth",
            "tokenUrl": "https://openapi.invalid/token",
            "scopes": {
              "email": "Email address",
              "openid": "OpenID Connect",
              "profile": "Profile"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": [ ]
    },
    {
      "OAuth2": [
        "email",
        "openid",
        "profile"
      ]
