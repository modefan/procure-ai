          {
            "name": "If-Match",
            "in": "header",
            "description": "The ETag of the version you last read, e.g. \"3\". Missing: 428; stale: 412.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
