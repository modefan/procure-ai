<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Approvals.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-approvals-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Approvals.Application/ProcureAi.Approvals.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Approvals.Infrastructure/ProcureAi.Approvals.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>approvals-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>approvalsdb</OpenApiDatabaseConnectionName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Approvals.IntegrationTests" />
  </ItemGroup>

</Project>
