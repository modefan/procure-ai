<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Budgets.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-budgets-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Budgets.Application/ProcureAi.Budgets.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Budgets.Infrastructure/ProcureAi.Budgets.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>budgets-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>budgetsdb</OpenApiDatabaseConnectionName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Budgets.IntegrationTests" />
  </ItemGroup>

</Project>
