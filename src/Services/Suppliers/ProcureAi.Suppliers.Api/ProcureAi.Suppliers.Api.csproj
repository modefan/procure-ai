<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ProcureAi.Suppliers.Api</RootNamespace>
    <!-- For the signing-free local config the API reads from user secrets (nothing sensitive is committed). -->
    <UserSecretsId>procure-ai-suppliers-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Suppliers.Application/ProcureAi.Suppliers.Application.csproj" />
    <ProjectReference Include="../ProcureAi.Suppliers.Infrastructure/ProcureAi.Suppliers.Infrastructure.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Hosting/ProcureAi.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Messaging/ProcureAi.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <!-- The OpenAPI document is written on every build and committed (see ../../Directory.Build.targets). -->
  <PropertyGroup>
    <OpenApiDocumentName>suppliers-v1</OpenApiDocumentName>
    <OpenApiDatabaseConnectionName>suppliersdb</OpenApiDatabaseConnectionName>
    <OpenApiDatabaseConnectionString>mongodb://openapi.invalid/suppliersdb</OpenApiDatabaseConnectionString>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProcureAi.Suppliers.IntegrationTests" />
  </ItemGroup>

</Project>
