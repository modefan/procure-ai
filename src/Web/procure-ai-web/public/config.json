{
  "apiBaseUrl": "",
  "logger": {
    "consoleLevel": "debug",
    "serverLevel": "warn",
    "serverUrl": "/api/client-logs",
    "batchSize": 10,
    "flushMs": 5000,
    "serverMaxPerMinute": 60
  },
  "paging": {
    "pageSize": 25
  },
  "live": {
    "heartbeatMs": 15000,
    "reconnectDelaysMs": [0, 2000, 5000, 10000, 30000],
    "offlineRetryMs": 30000
  },
  "cache": {
    "staleMs": 30000,
    "trailingReloadMs": 2000
  },
  "observability": {
    "dashboardUrl": "https://localhost:17100"
  },
  "devPanel": {
    "enabled": true
  },
  "maintenance": {
    "contactUrl": "",
    "contactLabel": "",
    "checkTimeoutMs": 4000
  }
}
