      },
      {
        "name": "admin",
        "description": "Procurement role: admin"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-procure",
    "description": "Keycloak defaults only; business roles are assigned explicitly",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization"
      ]
    }
  },
