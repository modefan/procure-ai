{
  "realm": "master",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "operator browser",
  "directGrantFlow": "operator direct grant",
  "clients": [
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "description": "Argo CD's Keycloak sign-in (Dale 2026-11-13): public, code flow + PKCE; Argo CD gives role:admin only to the users dale and operator",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://argocd.daleabels.com/auth/callback", "https://argocd.daleabels.com/pkce/verify", "http://127.0.0.1:8080/auth/callback", "http://127.0.0.1:8080/pkce/verify"],
      "webOrigins": ["https://argocd.daleabels.com", "http://127.0.0.1:8080"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://argocd.daleabels.com/*" }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "operator direct grant",
      "description": "Password grants (kcadm --user, admin-cli): user name, password AND one-time code for every user (plan 08b Task 4 fix round 1). The automation signs in as a client (client credentials), not through this flow.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "operator browser",
      "description": "Admin console and Argo CD sign-in: a session, or user name and password (OTP Form DISABLED, Dale 2026-11-13).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "operator browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "operator browser forms",
      "description": "Password only; the one-time code is switched off (Dale 2026-11-13)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
