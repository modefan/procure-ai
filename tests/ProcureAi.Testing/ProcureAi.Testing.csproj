<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test infrastructure: container fixtures with the repo's resource caps, test credentials and the API factory. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>ProcureAi.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BuildingBlocks/ProcureAi.BuildingBlocks.Web/ProcureAi.BuildingBlocks.Web.csproj" />
    <!-- DebeziumMongoUser: the MongoDB CDC fixture creates the least-privilege user the way Suppliers' migrate step does. -->
    <ProjectReference Include="../../src/BuildingBlocks/ProcureAi.BuildingBlocks.Persistence.Mongo/ProcureAi.BuildingBlocks.Persistence.Mongo.csproj" />
    <ProjectReference Include="../../src/Contracts/ProcureAi.Contracts/ProcureAi.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../testcontainers.settings.json" Link="testcontainers.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../infra/keycloak/procure-realm.json" Link="procure-realm.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
