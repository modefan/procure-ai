<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The Testcontainers and database calls here are short; threading the test token through every one adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ProcureAi.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProcureAi.Testing/ProcureAi.Testing.csproj" />
    <ProjectReference Include="../../src/BuildingBlocks/ProcureAi.BuildingBlocks.Persistence/ProcureAi.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="../../src/Services/Assistant/ProcureAi.Assistant.Infrastructure/ProcureAi.Assistant.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Services/Assistant/ProcureAi.Assistant.Api/ProcureAi.Assistant.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sample policy (Markdown and PDF) of the unit tests. -->
    <Content Include="../ProcureAi.Assistant.Tests/Files/**" LinkBase="Files" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
